# Koda web UI local development
# Copy to .env.local only when running the Next.js app outside Docker.

CONTROL_PLANE_BASE_URL=http://127.0.0.1:8090
HOST=0.0.0.0
PORT=3000
# Set a random value (e.g. `openssl rand -hex 32`) to keep sessions across restarts.
# Unedited `replace-with-...` placeholders are rejected.
WEB_OPERATOR_SESSION_SECRET=
# Local development only: without a secret, use an ephemeral random key
# (ignored when NODE_ENV=production).
ALLOW_INSECURE_WEB_OPERATOR_SESSION_SECRET=true
