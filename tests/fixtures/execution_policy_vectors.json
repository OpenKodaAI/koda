{
  "schema_version": 1,
  "description": "Execution-policy parity vectors (ADR-002 AG-06, ADR-008 step 1). Each vector is one tool call evaluated against one policy. tests/test_execution_policy_vectors.py runs every vector through the runtime engine, the way an agent worker calls it, and through the control-plane simulate route (POST /api/control-plane/agents/{agent_id}/execution-policy/evaluate); both must return the expected decision, reason_code and rule_id, and the same approval scope and preview. The file is also the shared input for the ADR-008 offline replay (M5-E3-T2). Rule semantics: among the rules that match a call, the most restrictive decision wins (deny > require_approval > allow_with_preview > allow), then the highest priority, then the lowest name; patterns are fnmatch globs compared case-insensitively; a path selector also covers everything below the path; every listed effect tag must be present; a selector the engine cannot evaluate (unknown key, empty value, ^regex) is skipped in a deny rule and makes any other rule not match.",
  "agent_id": "AGENT_VECTORS",
  "agent_defaults": {
    "tool_policy": {},
    "autonomy_policy": {},
    "mcp_tool_policies": {},
    "resource_access_policy": {
      "integration_grants": {
        "fileops": {"allow_actions": ["fileops.*"]},
        "web": {"allow_actions": ["search", "http.*"], "allowed_domains": ["api.example.com"]}
      }
    }
  },
  "vectors": [
    {
      "id": "deny-wins-over-higher-priority-allow",
      "description": "D-024: a validated mcp_*__delete_* deny is enforced even when a higher-priority allow also matches.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "priority": 100, "match": {"tool_id": "mcp_github__*"}, "decision": "allow"},
          {"name": "deny-mcp-deletes", "priority": 10, "match": {"tool_id": "mcp_*__delete_*"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__delete_repo", "params": {"repo": "koda"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-mcp-deletes"}
    },
    {
      "id": "mcp-delete-deny-applies-on-any-server",
      "description": "The interior wildcards of mcp_*__delete_* match every MCP server's delete tools.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-mcp-deletes", "match": {"tool_id": "mcp_*__delete_*"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_gitlab__delete_project", "params": {"project": "koda"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-mcp-deletes"}
    },
    {
      "id": "mcp-delete-deny-leaves-other-mcp-tools-alone",
      "description": "The delete deny does not match a non-delete tool; the allow still applies and the preview overlay degrades it.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "priority": 100, "match": {"tool_id": "mcp_github__*"}, "decision": "allow"},
          {"name": "deny-mcp-deletes", "priority": 10, "match": {"tool_id": "mcp_*__delete_*"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "allow_with_preview", "reason_code": "preview_required", "rule_id": null}
    },
    {
      "id": "require-approval-wins-over-allow-with-preview",
      "description": "Most restrictive wins: require_approval beats a higher-priority allow_with_preview.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "preview-file-writes", "priority": 50, "match": {"tool_id": "file_write"}, "decision": "allow_with_preview"},
          {"name": "approve-fileops", "priority": 10, "match": {"integration_id": "fileops"}, "decision": "require_approval"}
        ]
      },
      "action": {"tool_id": "file_write", "params": {"path": "/srv/app/notes.txt", "content": "hello"}},
      "expected": {"decision": "require_approval", "reason_code": "rule_match", "rule_id": "approve-fileops"}
    },
    {
      "id": "deny-wins-over-require-approval",
      "description": "Most restrictive wins: deny beats a higher-priority require_approval.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "approve-file-writes", "priority": 90, "match": {"tool_id": "file_write"}, "decision": "require_approval"},
          {"name": "deny-etc", "match": {"path": "/etc"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "file_write", "params": {"path": "/etc/hosts", "content": "127.0.0.1 koda"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-etc"}
    },
    {
      "id": "allow-with-preview-wins-over-allow",
      "description": "Most restrictive wins: allow_with_preview beats a higher-priority allow.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "priority": 100, "match": {"tool_id": "mcp_github__*"}, "decision": "allow"},
          {"name": "preview-github", "match": {"server_key": "github"}, "decision": "allow_with_preview"}
        ]
      },
      "action": {"tool_id": "mcp_github__list_issues", "params": {"state": "open"}},
      "expected": {"decision": "allow_with_preview", "reason_code": "rule_match", "rule_id": "preview-github"}
    },
    {
      "id": "priority-breaks-ties-within-one-decision",
      "description": "Among matching rules with the same decision, the highest priority supplies rule_id and approval settings.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "approve-low", "priority": 1, "match": {"tool_id": "file_write"}, "decision": "require_approval", "approval_scope_kind": "scope"},
          {"name": "approve-high", "priority": 5, "match": {"integration_id": "fileops"}, "decision": "require_approval", "approval_ttl_seconds": 120}
        ]
      },
      "action": {"tool_id": "file_write", "params": {"path": "/srv/app/notes.txt", "content": "hello"}},
      "expected": {"decision": "require_approval", "reason_code": "rule_match", "rule_id": "approve-high"}
    },
    {
      "id": "name-breaks-ties-at-equal-priority",
      "description": "Equal decision and priority: the rule whose name sorts first wins, independent of list order.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "b-deny-create-issue", "match": {"tool_id": "mcp_github__create_issue"}, "decision": "deny"},
          {"name": "a-deny-github", "match": {"server_key": "github"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "a-deny-github"}
    },
    {
      "id": "rule-name-is-the-audit-rule-id",
      "description": "A dashboard-authored rule (name/match) reports its name as rule_id.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-web-search", "match": {"tool_id": "web_search"}, "decision": "allow", "reason": "research_allowed"}
        ]
      },
      "action": {"tool_id": "web_search", "params": {"query": "koda"}},
      "expected": {"decision": "allow", "reason_code": "research_allowed", "rule_id": "allow-web-search"}
    },
    {
      "id": "legacy-id-selectors-and-action-keys-are-migrated",
      "description": "Runtime-legacy keys normalize to the canonical ones: id to name, selectors to match, action to decision.",
      "policy": {
        "version": 1,
        "rules": [
          {"id": "legacy-deny-create-issue", "selectors": {"tool_id": ["mcp_github__create_issue"]}, "action": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "legacy-deny-create-issue"}
    },
    {
      "id": "canonical-match-wins-over-legacy-selectors",
      "description": "When a rule carries both keys, match is used and selectors is discarded.",
      "policy": {
        "version": 1,
        "rules": [
          {
            "name": "deny-delete-only",
            "match": {"tool_id": "mcp_github__delete_repo"},
            "selectors": {"tool_id": "mcp_github__create_issue"},
            "decision": "deny"
          }
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "secure_default_block", "rule_id": null}
    },
    {
      "id": "interior-wildcard-allow-uses-fnmatch",
      "description": "Allow patterns are fnmatch globs too, so interior wildcards match.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-mcp-lists", "match": {"tool_id": "mcp_*__list_*"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "mcp_github__list_issues", "params": {"state": "open"}},
      "expected": {"decision": "allow", "reason_code": "rule_match", "rule_id": "allow-mcp-lists"}
    },
    {
      "id": "character-class-pattern-matches",
      "description": "fnmatch character classes: http.[pd]* matches http.post.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-http", "match": {"tool_id": "http_request"}, "decision": "allow"},
          {"name": "deny-http-writes", "match": {"tool_id": "http_request", "action_id": "http.[pd]*"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "http_request", "params": {"method": "POST", "url": "https://api.example.com/v1/items"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-http-writes"}
    },
    {
      "id": "character-class-pattern-does-not-match-other-methods",
      "description": "http.[pd]* does not match http.get, so the allow applies.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-http", "match": {"tool_id": "http_request"}, "decision": "allow"},
          {"name": "deny-http-writes", "match": {"tool_id": "http_request", "action_id": "http.[pd]*"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "http_request", "params": {"method": "GET", "url": "https://api.example.com/v1/items"}},
      "expected": {"decision": "allow", "reason_code": "rule_match", "rule_id": "allow-http"}
    },
    {
      "id": "path-selector-covers-the-directory-and-below",
      "description": "A path selector matches the path itself and everything below it.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-secrets", "match": {"path": "/srv/app/secrets"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "file_read", "params": {"path": "/srv/app/secrets/key.pem"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-secrets"}
    },
    {
      "id": "path-glob-covers-matching-directories-and-below",
      "description": "A path glob matches every directory it names and everything below them.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-any-secrets-dir", "match": {"path": "/srv/*/secrets"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "file_read", "params": {"path": "/srv/app/secrets/key.pem"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-any-secrets-dir"}
    },
    {
      "id": "path-selector-does-not-match-a-sibling-prefix",
      "description": "/srv/app/secrets does not cover /srv/app/secrets-public.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-secrets", "match": {"path": "/srv/app/secrets"}, "decision": "deny"},
          {"name": "allow-file-reads", "match": {"tool_id": "file_read"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "file_read", "params": {"path": "/srv/app/secrets-public/readme.md"}},
      "expected": {"decision": "allow", "reason_code": "rule_match", "rule_id": "allow-file-reads"}
    },
    {
      "id": "regex-pattern-in-deny-rule-fails-closed",
      "description": "Validation rejects ^regex; a stored one cannot be evaluated, so a deny rule skips that selector and matches more calls.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-web-search", "priority": 100, "match": {"tool_id": "web_search"}, "decision": "allow"},
          {"name": "deny-web-regex", "match": {"tool_id": "^web_.*"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "web_search", "params": {"query": "koda"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-web-regex"}
    },
    {
      "id": "regex-pattern-in-allow-rule-never-matches",
      "description": "A stored ^regex in an allow rule makes the rule not match; the secure default applies.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github-regex", "match": {"tool_id": "^mcp_github__.*"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "secure_default_block", "rule_id": null}
    },
    {
      "id": "unknown-selector-in-allow-rule-never-matches",
      "description": "An allow rule with a selector key the engine does not know never widens access.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-create-issue", "match": {"tool_id": "mcp_github__create_issue", "team": "core"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "secure_default_block", "rule_id": null}
    },
    {
      "id": "unknown-selector-in-deny-rule-is-skipped",
      "description": "A deny rule ignores a selector key the engine does not know, so it can only match more calls.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "priority": 100, "match": {"tool_id": "mcp_github__*"}, "decision": "allow"},
          {"name": "deny-create-issue", "match": {"tool_id": "mcp_github__create_issue", "team": "core"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-create-issue"}
    },
    {
      "id": "empty-selector-in-allow-rule-never-matches",
      "description": "An empty selector value is not a wildcard: an allow rule with one does not match.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-create-issue", "match": {"tool_id": "mcp_github__create_issue", "server_key": []}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "secure_default_block", "rule_id": null}
    },
    {
      "id": "rule-without-decision-requires-approval",
      "description": "A rule with no decision normalizes to require_approval, as the control plane stores it.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "unspecified", "match": {"tool_id": "mcp_github__create_issue"}}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "require_approval", "reason_code": "rule_match", "rule_id": "unspecified"}
    },
    {
      "id": "rule-with-invalid-decision-is-dropped",
      "description": "A rule with an unknown decision is dropped; with no valid rule left, the legacy baseline applies.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "bogus", "match": {"tool_id": "web_search"}, "decision": "maybe"}
        ]
      },
      "action": {"tool_id": "web_search", "params": {"query": "koda"}},
      "expected": {"decision": "allow", "reason_code": "secure_default_read", "rule_id": null}
    },
    {
      "id": "effect-tags-require-every-listed-tag",
      "description": "An effect_tags selector matches only when every listed tag is present.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "priority": 100, "match": {"tool_id": "mcp_github__*"}, "decision": "allow"},
          {"name": "deny-destructive-mcp", "match": {"effect_tags": ["destructive_change", "mcp_write"]}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "allow_with_preview", "reason_code": "preview_required", "rule_id": null}
    },
    {
      "id": "effect-tag-patterns-use-fnmatch",
      "description": "Effect-tag patterns are fnmatch globs.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-destructive", "match": {"effect_tags": ["destructive_*"]}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__delete_repo", "params": {"repo": "koda"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-destructive"}
    },
    {
      "id": "boolean-selectors-match-envelope-flags",
      "description": "Boolean selectors compare against the envelope flags.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-external-github-reads", "match": {"server_key": "github", "external_side_effect": true}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__list_issues", "params": {"state": "open"}},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-external-github-reads"}
    },
    {
      "id": "task-kind-selector",
      "description": "The task_kind given with the call reaches the task_kind selector.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "priority": 100, "match": {"tool_id": "mcp_github__*"}, "decision": "allow"},
          {"name": "deny-deploy-writes", "match": {"task_kind": "deploy", "access_level": ["write", "destructive"]}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}, "task_kind": "deploy"},
      "expected": {"decision": "deny", "reason_code": "rule_match", "rule_id": "deny-deploy-writes"}
    },
    {
      "id": "read-only-autonomy-denies-rule-allowed-writes",
      "description": "The agent's autonomy policy shapes the effective task policy; read_only denies a write a rule allowed.",
      "agent": {"autonomy_policy": {"default_approval_mode": "read_only"}},
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-github", "match": {"tool_id": "mcp_github__*"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "mcp_github__create_issue", "params": {"title": "Parity"}},
      "expected": {"decision": "deny", "reason_code": "read_only_policy", "rule_id": null}
    },
    {
      "id": "explicit-allow-degraded-by-preview-overlay",
      "description": "An allowed destructive file action still needs a preview.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-file-delete", "match": {"tool_id": "file_delete"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "file_delete", "params": {"path": "tmp.txt"}},
      "expected": {"decision": "allow_with_preview", "reason_code": "preview_required", "rule_id": null}
    },
    {
      "id": "safe-read-allowed-when-no-rule-matches",
      "description": "With rules present and none matching, a secure-default read is allowed.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-create-issue", "match": {"tool_id": "mcp_github__create_issue"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "web_search", "params": {"query": "koda"}},
      "expected": {"decision": "allow", "reason_code": "secure_default_read", "rule_id": null}
    },
    {
      "id": "non-safe-call-denied-when-no-rule-matches",
      "description": "With rules present and none matching, any other call is denied.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "deny-create-issue", "match": {"tool_id": "mcp_github__create_issue"}, "decision": "deny"}
        ]
      },
      "action": {"tool_id": "mcp_github__merge_pull_request", "params": {"number": 7}},
      "expected": {"decision": "deny", "reason_code": "secure_default_block", "rule_id": null}
    },
    {
      "id": "no-rules-fall-back-to-the-agents-legacy-mcp-policy",
      "description": "Without rules the legacy branch applies, using the evaluated agent's own MCP tool policy.",
      "agent": {"mcp_tool_policies": {"github": {"delete_repo": "blocked"}}},
      "policy": {},
      "action": {"tool_id": "mcp_github__delete_repo", "params": {"repo": "koda"}},
      "expected": {"decision": "deny", "reason_code": "mcp_blocked", "rule_id": null}
    },
    {
      "id": "unknown-tool-fails-closed",
      "description": "An unknown tool is denied before any rule, even a catch-all allow.",
      "policy": {
        "version": 1,
        "rules": [
          {"name": "allow-everything", "match": {"tool_id": "*"}, "decision": "allow"}
        ]
      },
      "action": {"tool_id": "totally_unknown_tool", "params": {}},
      "expected": {"decision": "deny", "reason_code": "unknown_action", "rule_id": null}
    }
  ]
}
